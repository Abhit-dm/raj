# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Build outputs
dist/
dist-ssr/
frontend/dist/
backend/dist/

# Environment files — keep .env.example but not real secrets
.env
.env.local
.env.production
frontend/.env
backend/.env

# Logs
*.log
npm-debug.log*

# Uploads (user files, not code)
backend/uploads/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# Prisma generated
backend/src/generated/

# Continuity
SESSION_HANDOFF.md
.continuity/*
# Continuity decision memory — travels with the repo (runtime state stays ignored)
!.continuity/decisions.jsonl
!.continuity/.gitattributes
!.continuity/SESSION_NOTES.md
!.continuity/INSTRUCTIONS.md

# Local test artifacts / release binaries (APKs are delivered separately, not committed)
.playwright-mcp/
release/

# App binaries served at /downloads (copied onto the server, not committed)
backend/downloads/*
!backend/downloads/.gitkeep
